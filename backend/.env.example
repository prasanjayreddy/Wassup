# Application authentication is prototype-only. Set this true outside local demos.
REQUIRE_PROTOTYPE_AUTH=true

# Private, self-hosted inference only. Do not point this to a third-party API.
INFERENCE_BASE_URL=http://localhost:8001/v1
INFERENCE_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
INFERENCE_MODEL_REVISION=a09a35458c702b33eeacc393d103063234e8bc28
INFERENCE_TIMEOUT_SECONDS=30
INFERENCE_MAX_CONCURRENCY=4
AI_MAX_CONTEXT_CHARS=6000
AI_MAX_GENERATED_TOKENS=160
AI_RATE_LIMIT_PER_MINUTE=20

# Optional shared secret for backend -> inference service. Never commit its value.
# INFERENCE_AUTH_TOKEN=
# DATABASE_URL=postgresql+psycopg://user:password@host/voice
